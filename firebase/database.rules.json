{
  "rules": {
    ".read": false,
    ".write": false,

    "rooms": {
      "$room": {
        ".read": true,
        ".write": "!data.exists() || (!newData.exists() && (!data.hasChild('owner') || (auth != null && data.child('owner').val() === auth.uid)))",
        ".validate": "$room.matches(/^[A-Z0-9]{4,8}$/) && newData.hasChildren(['question', 'options', 'votes', 'open', 'createdAt'])",

        "eierUid": {
          ".write": "auth != null && newData.val() === auth.uid && !data.parent().exists()",
          ".validate": "newData.isString() && newData.val() === auth.uid"
        },
        "delteUider": {
          "$deltUid": {
            ".write": "auth != null && newData.parent().parent().child('eierUid').val() === auth.uid",
            ".validate": "newData.isBoolean() && newData.val() === true"
          }
        },
        "klasseId": {
          ".write": "auth != null && newData.parent().child('eierUid').val() === auth.uid",
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 64"
        },
        "spill": {
          ".write": "auth != null && newData.parent().child('eierUid').val() === auth.uid",
          ".validate": "newData.isString() && newData.val().matches(/^[a-z0-9-]{1,40}$/)"
        },

        "question": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 300"
        },
        "options": {
          ".validate": "newData.hasChildren()",
          "$index": {
            ".validate": "$index.matches(/^[0-3]$/) && newData.isString() && newData.val().length <= 200"
          }
        },
        "votes": {
          ".validate": "newData.hasChildren(['0', '1'])",
          "$index": {
            ".write": "$index.matches(/^[0-3]$/) && data.exists() && newData.isNumber() && newData.val() === data.val() + 1 && (!data.parent().parent().hasChild('owner') || (auth != null && newData.parent().parent().child('voters').child(auth.uid).val() === true && !data.parent().parent().child('voters').child(auth.uid).exists()))",
            ".validate": "$index.matches(/^[0-3]$/) && newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000"
          }
        },
        "voters": {
          "$uid": {
            ".write": "auth != null && $uid === auth.uid && !data.exists()",
            ".validate": "newData.isBoolean() && newData.val() === true"
          }
        },
        "owner": {
          ".validate": "newData.isString() && auth != null && newData.val() === auth.uid"
        },
        "open": {
          ".validate": "newData.isBoolean()"
        },
        "createdAt": {
          ".validate": "newData.isNumber() && newData.val() <= now + 300000"
        },
        "$other": {
          ".validate": false
        }
      }
    },

    "krle": {
      "$room": {
        ".read": true,
        ".write": "!data.exists() || (!newData.exists() && (!data.hasChild('owner') || (auth != null && data.child('owner').val() === auth.uid)))",
        ".validate": "$room.matches(/^[A-Z0-9]{4,8}$/) && newData.hasChild('createdAt')",

        "createdAt": {
          ".validate": "newData.isNumber() && newData.val() <= now + 300000"
        },
        "owner": {
          ".validate": "newData.isString() && auth != null && newData.val() === auth.uid"
        },

        "state": {
          ".write": "data.parent().exists() && (!data.parent().hasChild('owner') || (auth != null && data.parent().child('owner').val() === auth.uid))",
          ".validate": "newData.hasChildren(['type', 'content', 'roll'])",
          "type": {
            ".validate": "newData.isString() && newData.val().matches(/^(activity|concept)$/)"
          },
          "content": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 500"
          },
          "roll": {
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 6"
          },
          "$other": {
            ".validate": false
          }
        },

        "teams": {
          "$team": {
            ".write": "!data.exists() && data.parent().parent().exists()",
            ".validate": "newData.hasChildren(['name', 'joinedAt'])",
            "name": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 24"
            },
            "joinedAt": {
              ".validate": "newData.isNumber() && newData.val() <= now + 300000"
            },
            "$other": {
              ".validate": false
            }
          }
        },

        "answers": {
          ".write": "!newData.exists() && data.parent().exists() && (!data.parent().hasChild('owner') || (auth != null && data.parent().child('owner').val() === auth.uid))",
          "$answer": {
            ".write": "!data.exists() && data.parent().parent().exists()",
            ".validate": "newData.hasChildren(['text', 'team', 'sentAt'])",
            "text": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 500"
            },
            "team": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 24"
            },
            "sentAt": {
              ".validate": "newData.isNumber() && newData.val() <= now + 300000"
            },
            "$other": {
              ".validate": false
            }
          }
        },

        "$other": {
          ".validate": false
        }
      }
    },

    "genetikhjul": {
      "$kode": {
        ".read": true,
        ".validate": "$kode.matches(/^[A-Z0-9-]{3,24}$/)",

        "owner": {
          ".write": "$kode.matches(/^[A-Z0-9-]{3,24}$/) && auth != null && newData.val() === auth.uid && (!data.exists() || data.val() === auth.uid || data.parent().child('createdAt').val() < now - 43200000)",
          ".validate": "newData.isString() && auth != null && newData.val() === auth.uid"
        },
        "createdAt": {
          ".write": "$kode.matches(/^[A-Z0-9-]{3,24}$/) && auth != null && (!data.exists() || data.val() < now - 43200000 || data.parent().child('owner').val() === auth.uid)",
          ".validate": "newData.isNumber() && newData.val() <= now + 300000"
        },

        "elever": {
          ".write": "!newData.exists() && (!data.parent().hasChild('owner') || (auth != null && data.parent().child('owner').val() === auth.uid) || (auth != null && data.parent().child('createdAt').val() < now - 43200000 && newData.parent().child('owner').val() === auth.uid))",

          "$elev": {
            ".write": "$kode.matches(/^[A-Z0-9-]{3,24}$/) && !data.exists() && newData.exists()",
            ".validate": "newData.hasChildren(['navn', 'kjonn', 'svar', 'ts'])",

            "navn": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 24"
            },
            "kjonn": {
              ".validate": "newData.isString() && newData.val().matches(/^(M|F|X)$/)"
            },
            "svar": {
              ".validate": "newData.hasChildren(['T', 'E', 'H', 'D', 'W', 'B'])",
              "$gen": {
                ".validate": "$gen.matches(/^[TEHDWB]$/) && newData.isString() && newData.val().matches(/^(dom|rec)$/)"
              }
            },
            "ts": {
              ".validate": "newData.isNumber() && newData.val() <= now + 300000"
            },
            "$other": {
              ".validate": false
            }
          }
        },

        "$other": {
          ".validate": false
        }
      }
    },

    "temaspinner": {
      "$kode": {
        ".read": true,
        ".write": "$kode.matches(/^[A-Z0-9]{4,8}$/) && auth != null && (!data.exists() || data.child('owner').val() === auth.uid || data.child('opprettet').val() < now - 43200000)",
        ".validate": "newData.hasChildren(['opprettet', 'owner', 'fase', 'temaListe'])",

        "owner": {
          ".validate": "newData.isString() && auth != null && newData.val() === auth.uid"
        },
        "opprettet": {
          ".validate": "newData.isNumber() && newData.val() <= now + 300000"
        },
        "varighetMs": {
          ".write": "auth != null && root.child('temaspinner').child($kode).child('owner').val() === auth.uid",
          ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 7200000"
        },
        "byttBillettPa": {
          ".write": "auth != null && root.child('temaspinner').child($kode).child('owner').val() === auth.uid",
          ".validate": "newData.isBoolean()"
        },

        "fase": {
          ".write": "auth != null && root.child('temaspinner').child($kode).child('owner').val() === auth.uid",
          ".validate": "newData.isString() && newData.val().matches(/^(lobby|trekning|forberedelse|ferdig)$/)"
        },

        "temaListe": {
          ".write": "auth != null && root.child('temaspinner').child($kode).child('owner').val() === auth.uid",
          "$i": {
            ".validate": "$i.matches(/^[0-9]{1,3}$/) && newData.isString() && newData.val().length > 0 && newData.val().length <= 120"
          }
        },

        "stokk": {
          ".write": "auth != null && root.child('temaspinner').child($kode).child('owner').val() === auth.uid",
          "igjen": {
            "$i": {
              ".validate": "$i.matches(/^[0-9]{1,3}$/) && newData.isString() && newData.val().length > 0 && newData.val().length <= 120"
            }
          },
          "$other": {
            ".validate": false
          }
        },

        "klokke": {
          ".write": "auth != null && root.child('temaspinner').child($kode).child('owner').val() === auth.uid",
          "endsAt": {
            ".validate": "newData.isNumber()"
          },
          "pausetMedIgjen": {
            ".validate": "newData.isNumber() && newData.val() >= 0"
          },
          "$other": {
            ".validate": false
          }
        },

        "elever": {
          ".write": "!newData.exists() && auth != null && root.child('temaspinner').child($kode).child('owner').val() === auth.uid",

          "$elev": {
            ".write": "auth != null && root.child('temaspinner').child($kode).child('owner').val() === auth.uid",
            ".validate": "newData.hasChildren(['navn', 'ts'])",

            "navn": {
              ".write": "auth != null && $elev === auth.uid && !data.exists()",
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 24"
            },
            "ts": {
              ".write": "auth != null && $elev === auth.uid && !data.exists()",
              ".validate": "newData.isNumber() && newData.val() <= now + 300000"
            },
            "onskerBytte": {
              ".write": "auth != null && $elev === auth.uid && root.child('temaspinner').child($kode).child('byttBillettPa').val() === true && root.child('temaspinner').child($kode).child('elever').child($elev).child('harByttet').val() !== true",
              ".validate": "newData.isBoolean()"
            },
            "tema": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 120"
            },
            "harByttet": {
              ".validate": "newData.isBoolean()"
            },
            "$other": {
              ".validate": false
            }
          }
        },

        "$other": {
          ".validate": false
        }
      }
    },

    "tankesky": {
      "$kode": {
        ".read": true,
        ".write": "$kode.matches(/^[A-Z0-9]{4,8}$/) && auth != null && (!data.exists() || data.child('owner').val() === auth.uid || data.child('opprettet').val() < now - 43200000)",
        ".validate": "newData.hasChildren(['opprettet', 'owner', 'tema', 'friFlyt', 'runde'])",

        "owner": {
          ".validate": "newData.isString() && auth != null && newData.val() === auth.uid"
        },
        "opprettet": {
          ".validate": "newData.isNumber() && newData.val() <= now + 300000"
        },
        "tema": {
          ".write": "auth != null && root.child('tankesky').child($kode).child('owner').val() === auth.uid",
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 120"
        },
        "friFlyt": {
          ".write": "auth != null && root.child('tankesky').child($kode).child('owner').val() === auth.uid",
          ".validate": "newData.isBoolean()"
        },
        "runde": {
          ".write": "auth != null && root.child('tankesky').child($kode).child('owner').val() === auth.uid",
          ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 100000"
        },

        "ord": {
          ".write": "auth != null && root.child('tankesky').child($kode).child('owner').val() === auth.uid",

          "$ordId": {
            ".write": "auth != null && (root.child('tankesky').child($kode).child('owner').val() === auth.uid || (!data.exists() && newData.exists() && newData.child('count').val() === 1) || (data.exists() && newData.exists() && newData.child('tekst').val() === data.child('tekst').val() && newData.child('tekstNorm').val() === data.child('tekstNorm').val() && newData.child('count').val() === data.child('count').val() + 1) || (data.exists() && root.child('tankesky').child($kode).child('innsendinger').child(auth.uid).child('ordId').val() === $ordId && ((newData.exists() && newData.child('tekst').val() === data.child('tekst').val() && newData.child('tekstNorm').val() === data.child('tekstNorm').val() && newData.child('count').val() === data.child('count').val() - 1) || (!newData.exists() && data.child('count').val() <= 1))))",
            ".validate": "newData.hasChildren(['tekst', 'tekstNorm', 'count', 'sistOppdatert'])",

            "tekst": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60"
            },
            "tekstNorm": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60"
            },
            "count": {
              ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 100000"
            },
            "sistOppdatert": {
              ".validate": "newData.isNumber() && newData.val() <= now + 300000"
            },
            "$other": {
              ".validate": false
            }
          }
        },

        "innsendinger": {
          ".write": "auth != null && root.child('tankesky').child($kode).child('owner').val() === auth.uid",

          "$elevId": {
            ".write": "auth != null && $elevId === auth.uid",
            ".validate": "newData.hasChildren(['ordId', 'runde', 'tekst'])",

            "ordId": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40"
            },
            "runde": {
              ".validate": "newData.isNumber() && newData.val() === root.child('tankesky').child($kode).child('runde').val()"
            },
            "tekst": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60"
            },
            "$other": {
              ".validate": false
            }
          }
        },

        "$other": {
          ".validate": false
        }
      }
    },

    "dagsformen": {
      "$kode": {
        ".read": true,
        ".write": "$kode.matches(/^[A-Z0-9]{4,8}$/) && auth != null && (!data.exists() || data.child('owner').val() === auth.uid || data.child('opprettet').val() < now - 43200000)",
        ".validate": "newData.hasChildren(['opprettet', 'owner', 'tema'])",

        "owner": {
          ".validate": "newData.isString() && auth != null && newData.val() === auth.uid"
        },
        "opprettet": {
          ".validate": "newData.isNumber() && newData.val() <= now + 300000"
        },
        "tema": {
          ".write": "auth != null && root.child('dagsformen').child($kode).child('owner').val() === auth.uid",
          ".validate": "newData.isString() && newData.val().matches(/^[a-z0-9-]{1,40}$/)"
        },

        "elever": {
          ".write": "auth != null && root.child('dagsformen').child($kode).child('owner').val() === auth.uid",

          "$elevId": {
            ".write": "auth != null && $elevId === auth.uid",
            ".validate": "newData.hasChildren(['valgt', 'ts'])",

            "valgt": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 29"
            },
            "ts": {
              ".validate": "newData.isNumber() && newData.val() <= now + 300000"
            },
            "$other": {
              ".validate": false
            }
          }
        },

        "$other": {
          ".validate": false
        }
      }
    },

    "tidsarkivet": {
      "$kode": {
        ".read": true,
        ".write": "$kode.matches(/^[A-Z0-9]{4,8}$/) && auth != null && (!data.exists() || data.child('owner').val() === auth.uid || data.child('opprettet').val() < now - 43200000)",
        ".validate": "newData.hasChildren(['opprettet', 'owner', 'fase', 'diff'])",

        "owner": {
          ".validate": "newData.isString() && auth != null && newData.val() === auth.uid"
        },
        "opprettet": {
          ".validate": "newData.isNumber() && newData.val() <= now + 300000"
        },
        "diff": {
          ".write": "auth != null && root.child('tidsarkivet').child($kode).child('owner').val() === auth.uid",
          ".validate": "newData.isString() && newData.val().matches(/^(rekrutt|agent|tidsmester)$/)"
        },
        "fase": {
          ".write": "auth != null && root.child('tidsarkivet').child($kode).child('owner').val() === auth.uid",
          ".validate": "newData.isString() && newData.val().matches(/^(lobby|spill|ferdig)$/)"
        },
        "itemIds": {
          ".write": "auth != null && root.child('tidsarkivet').child($kode).child('owner').val() === auth.uid",
          "$i": {
            ".validate": "$i.matches(/^[0-9]{1,2}$/) && newData.isString() && newData.val().length > 0 && newData.val().length <= 80"
          }
        },
        "runde": {
          ".write": "auth != null && root.child('tidsarkivet').child($kode).child('owner').val() === auth.uid",
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 20"
        },
        "tving": {
          ".write": "auth != null && root.child('tidsarkivet').child($kode).child('owner').val() === auth.uid",
          ".validate": "newData.isNumber() && newData.val() <= now + 300000"
        },

        "spillere": {
          ".write": "!newData.exists() && auth != null && root.child('tidsarkivet').child($kode).child('owner').val() === auth.uid",

          "$uid": {
            ".write": "auth != null && $uid === auth.uid && ((data.exists() && !newData.exists()) || (!data.exists() && data.parent().exists()))",
            ".validate": "newData.hasChildren(['navn', 'ts'])",

            "navn": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 30"
            },
            "ts": {
              ".validate": "newData.isNumber() && newData.val() <= now + 300000"
            },
            "gjett": {
              "$runde": {
                ".write": "auth != null && $uid === auth.uid && !data.exists()",
                ".validate": "newData.hasChildren(['g', 'dec', 'ts']) && newData.child('g').isNumber() && newData.child('g').val() >= 1850 && newData.child('g').val() <= 2010 && newData.child('dec').isBoolean() && newData.child('ts').isNumber() && newData.child('ts').val() <= now + 300000"
              }
            },
            "$other": {
              ".validate": false
            }
          }
        },

        "$other": {
          ".validate": false
        }
      }
    },

    "eliquiz": {
      "$kode": {
        ".read": true,
        ".write": "$kode.matches(/^[A-Z0-9]{4,8}$/) && auth != null && (!data.exists() || data.child('owner').val() === auth.uid || data.child('createdAt').val() < now - 43200000)",
        ".validate": "newData.hasChildren(['owner', 'createdAt', 'phase'])",

        "owner": {
          ".validate": "newData.isString() && auth != null && newData.val() === auth.uid"
        },
        "createdAt": {
          ".validate": "newData.isNumber() && newData.val() <= now + 300000"
        },

        "phase": {
          ".write": "auth != null && root.child('eliquiz').child($kode).child('owner').val() === auth.uid",
          ".validate": "newData.isString() && newData.val().matches(/^(lobby|music|timeline|tiebreaker|finished)$/)"
        },
        "currentRound": {
          ".write": "auth != null && root.child('eliquiz').child($kode).child('owner').val() === auth.uid",
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 15"
        },
        "roundStatus": {
          ".write": "auth != null && root.child('eliquiz').child($kode).child('owner').val() === auth.uid",
          ".validate": "newData.isString() && newData.val().matches(/^(ready|answering|scoring|reveal|leaderboard)$/)"
        },
        "finalOpen": {
          ".write": "auth != null && root.child('eliquiz').child($kode).child('owner').val() === auth.uid",
          ".validate": "newData.isBoolean()"
        },
        "tiebreakerActive": {
          ".write": "auth != null && root.child('eliquiz').child($kode).child('owner').val() === auth.uid",
          ".validate": "newData.isBoolean()"
        },
        "tiebreakerStartedAt": {
          ".write": "auth != null && root.child('eliquiz').child($kode).child('owner').val() === auth.uid",
          ".validate": "newData.isNumber() || newData.val() === null"
        },
        "tiebreakerResolved": {
          ".write": "auth != null && root.child('eliquiz').child($kode).child('owner').val() === auth.uid",
          ".validate": "newData.isBoolean()"
        },
        "tiebreakerWinner": {
          ".write": "auth != null && root.child('eliquiz').child($kode).child('owner').val() === auth.uid",
          ".validate": "newData.isString() || newData.val() === null"
        },
        "finaleRevealIndex": {
          ".write": "auth != null && root.child('eliquiz').child($kode).child('owner').val() === auth.uid",
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 16"
        },
        "timelineStatus": {
          ".write": "auth != null && root.child('eliquiz').child($kode).child('owner').val() === auth.uid",
          ".validate": "newData.isString() && newData.val().matches(/^(open|revealing)$/)"
        },
        "playback": {
          ".write": "auth != null && root.child('eliquiz').child($kode).child('owner').val() === auth.uid",
          ".validate": "!newData.exists() || (newData.hasChildren(['startedAt', 'durationMs']) && newData.child('durationMs').isNumber() && newData.child('durationMs').val() > 0 && newData.child('durationMs').val() <= 60000)",
          "startedAt": {
            ".validate": "newData.val() === now"
          },
          "durationMs": {
            ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 60000"
          },
          "$other": {
            ".validate": false
          }
        },

        "teams": {
          "$uid": {
            ".write": "auth != null && $uid === auth.uid && !data.exists() && data.parent().parent().exists()",
            ".validate": "newData.hasChildren(['name', 'icon', 'color', 'joinedAt'])",
            "name": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 28"
            },
            "icon": {
              ".validate": "newData.isString() && newData.val().length <= 8"
            },
            "color": {
              ".validate": "newData.isString() && newData.val().length <= 16"
            },
            "joinedAt": {
              ".validate": "newData.isNumber() && newData.val() <= now + 300000"
            },
            "$other": {
              ".validate": false
            }
          }
        },

        "answers": {
          "$uid": {
            ".write": "auth != null && $uid === auth.uid",
            "$round": {
              ".validate": "$round.matches(/^([0-9]|1[0-5])$/) && newData.hasChildren(['artist', 'title', 'updatedAt'])",
              "artist": {
                ".validate": "newData.isString() && newData.val().length <= 80"
              },
              "title": {
                ".validate": "newData.isString() && newData.val().length <= 80"
              },
              "updatedAt": {
                ".validate": "newData.isNumber() && newData.val() <= now + 300000"
              },
              "$other": {
                ".validate": false
              }
            }
          }
        },

        "results": {
          ".write": "auth != null && root.child('eliquiz').child($kode).child('owner').val() === auth.uid",
          "$round": {
            ".validate": "$round.matches(/^([0-9]|1[0-5])$/)",
            "songId": {
              ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 16"
            },
            "artist": {
              ".validate": "newData.isString() && newData.val().length <= 120"
            },
            "title": {
              ".validate": "newData.isString() && newData.val().length <= 120"
            },
            "perTeam": {
              "$uid": {
                ".validate": "newData.hasChildren(['artistCorrect', 'titleCorrect', 'points'])",
                "artistCorrect": { ".validate": "newData.isBoolean()" },
                "titleCorrect": { ".validate": "newData.isBoolean()" },
                "points": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 2" },
                "$other": { ".validate": false }
              }
            },
            "$other": {
              ".validate": false
            }
          }
        },

        "finalAnswers": {
          "$uid": {
            ".write": "auth != null && $uid === auth.uid",
            "$song": {
              ".validate": "$song.matches(/^([1-9]|1[0-6])$/) && newData.isNumber() && newData.val() >= 2011 && newData.val() <= 2026"
            }
          }
        },
        "finalSubmitted": {
          "$uid": {
            ".write": "auth != null && $uid === auth.uid",
            ".validate": "newData.isBoolean()"
          }
        },
        "finalResults": {
          ".write": "auth != null && root.child('eliquiz').child($kode).child('owner').val() === auth.uid",
          "$uid": {
            ".validate": "newData.hasChild('correct') && newData.child('correct').isNumber() && newData.child('correct').val() >= 0 && newData.child('correct').val() <= 16"
          }
        },
        "finaleReveal": {
          ".write": "auth != null && root.child('eliquiz').child($kode).child('owner').val() === auth.uid",
          "$song": {
            ".validate": "$song.matches(/^([1-9]|1[0-6])$/) && newData.hasChildren(['year', 'artist', 'title'])",
            "year": { ".validate": "newData.isNumber() && newData.val() >= 2011 && newData.val() <= 2026" },
            "artist": { ".validate": "newData.isString() && newData.val().length <= 120" },
            "title": { ".validate": "newData.isString() && newData.val().length <= 120" },
            "$other": { ".validate": false }
          }
        },

        "tiebreakerEligible": {
          ".write": "auth != null && root.child('eliquiz').child($kode).child('owner').val() === auth.uid",
          "$uid": {
            ".validate": "newData.isBoolean()"
          }
        },
        "tiebreakerAnswers": {
          ".write": "auth != null && root.child('eliquiz').child($kode).child('owner').val() === auth.uid",
          "$uid": {
            ".write": "auth != null && $uid === auth.uid && root.child('eliquiz').child($kode).child('tiebreakerEligible').child($uid).val() === true",
            ".validate": "newData.hasChildren(['artist', 'title', 'year', 'answeredAt'])",
            "artist": { ".validate": "newData.isString() && newData.val().length <= 80" },
            "title": { ".validate": "newData.isString() && newData.val().length <= 80" },
            "year": { ".validate": "newData.isNumber() && newData.val() >= 1900 && newData.val() <= 2100" },
            "answeredAt": { ".validate": "newData.val() === now" },
            "$other": { ".validate": false }
          }
        },

        "$other": {
          ".validate": false
        }
      }
    },

    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",

        "profile": {
          ".validate": "newData.hasChildren(['navn', 'epost', 'opprettet'])",
          "navn": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60"
          },
          "epost": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 254"
          },
          "opprettet": {
            ".validate": "newData.isNumber() && newData.val() <= now + 300000"
          },
          "$other": {
            ".validate": false
          }
        },

        "klasser": {
          "$klasseId": {
            ".validate": "newData.hasChildren(['navn', 'trinn', 'opprettet'])",
            "navn": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60"
            },
            "trinn": {
              ".validate": "newData.isString() && newData.val().length <= 20"
            },
            "opprettet": {
              ".validate": "newData.isNumber() && newData.val() <= now + 300000"
            },
            "elever": {
              "$i": {
                ".validate": "$i.matches(/^[0-9]{1,3}$/) && newData.hasChild('navn')",
                "navn": {
                  ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40"
                },
                "kjonn": {
                  ".validate": "newData.isString() && newData.val().matches(/^(j|g|a)$/)"
                },
                "$other": {
                  ".validate": false
                }
              }
            },
            "$other": {
              ".validate": false
            }
          }
        },

        "spillinnstillinger": {
          "$spillnavn": {
            ".validate": "$spillnavn.matches(/^[a-z0-9-]{1,40}$/)"
          }
        },

        "rom": {
          "$spillnavn": {
            ".validate": "$spillnavn.matches(/^[a-z0-9-]{1,40}$/)",
            "$romkode": {
              ".validate": "$romkode.matches(/^[A-Z0-9]{4,8}$/) && newData.hasChild('opprettet')",
              "opprettet": {
                ".validate": "newData.isNumber() && newData.val() <= now + 300000"
              },
              "klasseId": {
                ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 64"
              },
              "$other": {
                ".validate": false
              }
            }
          }
        },

        "$other": {
          ".validate": false
        }
      }
    },

    "bruk": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('admin').val() === true",

      "$dato": {
        "$side": {
          "$hendelse": {
            ".write": "$dato.matches(/^20[2-9][0-9]-[01][0-9]-[0-3][0-9]$/) && $side.matches(/^[a-z0-9-]{1,60}$/) && $hendelse.matches(/^[a-z0-9-]{1,24}$/) && ((!data.exists() && newData.val() === 1) || newData.val() === data.val() + 1)",
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 100000000"
          }
        }
      }
    },

    "deling": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('admin').val() === true",

      "$dato": {
        "$side": {
          "$knapp": {
            ".write": "$dato.matches(/^20[2-9][0-9]-[01][0-9]-[0-3][0-9]$/) && $side.matches(/^[a-z0-9-]{1,60}$/) && $knapp.matches(/^[a-z0-9-]{1,24}$/) && ((!data.exists() && newData.val() === 1) || newData.val() === data.val() + 1)",
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 100000000"
          }
        }
      }
    },

    "resultater": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",

        "$spillnavn": {
          "$oktId": {
            ".validate": "newData.hasChildren(['dato', 'romkode'])",
            "dato": {
              ".validate": "newData.isNumber() && newData.val() <= now + 300000"
            },
            "romkode": {
              ".validate": "newData.isString() && newData.val().length <= 12"
            },
            "$other": {
              ".validate": "newData.isNumber() || newData.isString() || newData.isBoolean()"
            }
          }
        }
      }
    },

    "ledertavle": {
      "$spill": {
        "$tavle": {
          ".read": true,
          ".indexOn": ["ms", "ts"],

          "$oppforing": {
            ".write": "$spill.matches(/^[a-z0-9-]{1,40}$/) && $tavle.matches(/^[a-z0-9_-]{1,60}$/) && !data.exists() && newData.exists()",
            ".validate": "newData.hasChildren(['navn', 'n', 'ts']) && ((newData.hasChild('ms') && !newData.hasChild('pts') && $tavle.matches(/_tid$/) && newData.child('ms').val() >= newData.child('n').val() * 400) || (newData.hasChild('pts') && !newData.hasChild('ms') && $tavle.matches(/_arkade$/) && newData.child('pts').val() <= newData.child('n').val() * 3000))",

            "navn": {
              ".validate": "newData.isString() && newData.val().matches(/^\\S{1,3}$/)"
            },
            "ms": {
              ".validate": "newData.isNumber() && newData.val() >= 400 && newData.val() <= 3600000"
            },
            "pts": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 300000"
            },
            "n": {
              ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 100"
            },
            "ts": {
              ".validate": "newData.isNumber() && newData.val() <= now + 300000 && newData.val() >= now - 300000"
            },
            "$other": {
              ".validate": false
            }
          }
        }
      }
    }
  }
}
