function pickTeam(i){
  G.humans.push({teamIdx:i,label:'Spiller '+(G.pickIdx+1)});
  G.pickIdx++;
  if(G.pickIdx<G.numHumans)renderPick();
  else runGroupStage();
}

/* ============ GRUPPESPILL ============ */
function runGroupStage(){
  const humanIdx=G.humans.map(h=>h.teamIdx);
  const others=shuffle(TEAMS.map((_,i)=>i).filter(i=>!humanIdx.includes(i)));
  const groups=[];for(let g=0;g<12;g++)groups.push([]);
  humanIdx.forEach((ti,k)=>groups[k*3].push(ti));
  let oi=0;
  for(let g=0;g<12;g++)while(groups[g].length<4)groups[g].push(others[oi++]);
  G.groups=groups.map(g=>{
    const rows=g.map(ti=>({ti,pts:3+Math.floor(Math.random()*5),human:humanIdx.includes(ti)}));
    rows.forEach(r=>{if(r.human)r.pts=9;});
    rows.sort((a,b)=>b.pts-a.pts||Math.random()-0.5);
    return rows;
  });
  const winners=G.groups.map(g=>g[0]);
  const runners=G.groups.map(g=>g[1]).sort((a,b)=>b.pts-a.pts);
  const qualifiedSet=new Set([...winners,...runners.slice(0,4)].map(r=>r.ti));
  G.qualified=[...qualifiedSet];
  renderGroups(qualifiedSet);
  showScreen('groupScreen');
}

function renderGroups(qualifiedSet){
  const grid=document.getElementById('groupGrid');grid.innerHTML='';
  const letters='ABCDEFGHIJKL';
  G.groups.forEach((g,gi)=>{
    const box=document.createElement('div');box.className='group-box';
    box.innerHTML=`<div class="group-title">GRUPPE ${letters[gi]}</div>`+
      g.map(r=>{
        const t=TEAMS[r.ti];
        const q=qualifiedSet.has(r.ti);
        return `<div class="group-row ${q?'qualified':''} ${r.human?'human-team':''}">
          <span>${t.flag}</span><span style="font-size:11px;font-weight:600;">${t.name}</span>
          ${r.human?'<span class="you-marker">DU</span>':''}
          <span class="gpts">${r.pts}p</span></div>`;
      }).join('');
    grid.appendChild(box);
    setTimeout(()=>box.classList.add('reveal'),gi*150);
  });
  setTimeout(()=>{document.getElementById('toBracketBtn').disabled=false;},12*150+300);
}

/* ============ BRACKET ============ */
function showBracket(){
  if(!G.rounds){
    const humanTi=G.humans.map(h=>h.teamIdx);
    const humanQ=G.qualified.filter(ti=>humanTi.includes(ti));
    const aiQ=shuffle(G.qualified.filter(ti=>!humanTi.includes(ti)));
    const seeds=new Array(16).fill(null);
    const humanSlots=[0,8,4,12];
    humanQ.forEach((ti,i)=>seeds[humanSlots[i]]=ti);
    let ai=0;
    for(let i=0;i<16;i++)if(seeds[i]===null)seeds[i]=aiQ[ai++];
    G.rounds=[[],[],[],[]];
    for(let i=0;i<8;i++)G.rounds[0].push({a:seeds[i*2],b:seeds[i*2+1],winner:null,score:null});
    for(let i=0;i<4;i++)G.rounds[1].push({a:null,b:null,winner:null,score:null});
    for(let i=0;i<2;i++)G.rounds[2].push({a:null,b:null,winner:null,score:null});
    G.rounds[3].push({a:null,b:null,winner:null,score:null});
    G.curRound=0;
  }
  renderBracket();
  showScreen('bracketScreen');
  updateBracketBtn();
}

function isHumanTeam(ti){return ti!==null&&ti!==undefined&&G.humans.some(h=>h.teamIdx===ti);}
function humanOf(ti){return G.humans.find(h=>h.teamIdx===ti)||null;}

function nextPendingMatch(){
  const r=G.rounds[G.curRound];
  for(let i=0;i<r.length;i++)if(r[i].winner===null&&r[i].a!==null&&r[i].b!==null)return i;
  return -1;
}

function renderBracket(){
  document.getElementById('bracketTitle').textContent=G.curRound===3?'VM-FINALEN · METLIFE STADIUM':ROUND_NAMES[G.curRound]+'R';
  const wrap=document.getElementById('bracketWrap');wrap.innerHTML='';
  const titles=['Åttedelsfinaler','Kvartfinaler','Semifinaler','Finale'];
  G.rounds.forEach((round,ri)=>{
    const col=document.createElement('div');
    col.className='round-col '+(ri<2?'early':'late');
    col.innerHTML=`<div class="round-title">${titles[ri]}</div>`;
    round.forEach((m,mi)=>{
      const div=document.createElement('div');
      div.className='bmatch';
      const isNext=ri===G.curRound&&mi===nextPendingMatch()&&(isHumanTeam(m.a)||isHumanTeam(m.b));
      if(isNext)div.classList.add('next-human');
      div.innerHTML=brow(m.a,m,true)+brow(m.b,m,false);
      col.appendChild(div);
    });
    wrap.appendChild(col);
  });
}

function brow(ti,m,isA){
  if(ti===null)return `<div class="brow"><span class="bflag">·</span><span class="bname" style="color:var(--muted);">–</span></div>`;
  const t=TEAMS[ti];
  const decided=m.winner!==null;
  const won=decided&&m.winner===ti;
  const cls=decided?(won?'winner':'loser'):'';
  const sc=m.score?(isA?m.score[0]:m.score[1]):'';
  return `<div class="brow ${cls} ${isHumanTeam(ti)?'human':''}" style="--kit:${t.kit[0]}">
    <span class="bflag">${t.flag}</span><span class="bname">${t.name}</span>
    ${isHumanTeam(ti)?'<span class="you-marker">DU</span>':''}
    <span class="bscore">${sc}</span></div>`;
}

function updateBracketBtn(){
  const btn=document.getElementById('bracketNextBtn');
  const idx=nextPendingMatch();
  if(idx===-1){btn.textContent='Neste runde →';return;}
  const m=G.rounds[G.curRound][idx];
  btn.textContent=(isHumanTeam(m.a)||isHumanTeam(m.b))?'⚽ Spill kampen':'Simuler kamper →';
}

function bracketNext(){
  const idx=nextPendingMatch();
  if(idx===-1){advanceRound();return;}
  const m=G.rounds[G.curRound][idx];
  if(isHumanTeam(m.a)||isHumanTeam(m.b))startMatch(idx);
  else simulateAIMatches();
}

function simulateAIMatches(){
  const feed=document.getElementById('simFeed');feed.innerHTML='';
  const r=G.rounds[G.curRound];
  let delay=0;
  r.forEach((m)=>{
    if(m.winner!==null||m.a===null||isHumanTeam(m.a)||isHumanTeam(m.b))return;
    const aWins=Math.random()<0.5;
    let sa=Math.floor(Math.random()*3)+1,sb;
    do{sb=Math.floor(Math.random()*3)+1;}while(sb===sa);
    if(aWins&&sa<sb)[sa,sb]=[sb,sa];
    if(!aWins&&sa>sb)[sa,sb]=[sb,sa];
    m.winner=aWins?m.a:m.b;m.score=[sa,sb];
    const line=document.createElement('div');
    line.className='sim-line';
    const w=TEAMS[m.winner];
    line.innerHTML=`${TEAMS[m.a].flag} ${TEAMS[m.a].name} ${sa}–${sb} ${TEAMS[m.b].name} ${TEAMS[m.b].flag} · <span class="sw">${w.name} videre etter straffekonk!</span>`;
    feed.appendChild(line);
    delay+=350;
    setTimeout(()=>line.classList.add('reveal'),delay);
  });
  setTimeout(()=>{renderBracket();updateBracketBtn();},delay+400);
}

function advanceRound(){
  const r=G.rounds[G.curRound];
  if(r.some(m=>m.winner===null))return;
  if(G.curRound===3){crownChampion(G.rounds[3][0].winner);return;}
  const next=G.rounds[G.curRound+1];
  for(let i=0;i<next.length;i++){next[i].a=r[i*2].winner;next[i].b=r[i*2+1].winner;}
  G.curRound++;
  document.getElementById('simFeed').innerHTML='';
  renderBracket();updateBracketBtn();
}

/* ============ KAMP ============ */
function startMatch(matchIdx){
  const m=G.rounds[G.curRound][matchIdx];
  const hA=humanOf(m.a),hB=humanOf(m.b);
  M={
    matchIdx,a:m.a,b:m.b,
    ctrlA:hA?'L':'AI',
    ctrlB:hB?(hA?'R':'L'):'AI',
    scoreA:0,scoreB:0,takenA:0,takenB:0,
    resultsA:[],resultsB:[],
    sudden:false,phase:'idle',choices:{shoot:null,save:null},
    shooterIsA:true,countTimer:null,
  };
  M.soloHuman=(hA&&!hB)||(hB&&!hA);

  const ta=TEAMS[m.a],tb=TEAMS[m.b];
  document.getElementById('miRound').textContent=ROUND_NAMES[G.curRound];
  setVs('A',ta,hA);setVs('B',tb,hB);
  showScreen('matchIntro');
}

function setVs(side,t,h){
  document.getElementById('miFlag'+side).textContent=t.flag;
  document.getElementById('miName'+side).textContent=t.name;
  document.getElementById('miStar'+side).textContent='⭐ '+t.star;
  document.getElementById('miKit'+side).innerHTML=`<span style="background:${t.kit[0]}"></span><span style="background:${t.kit[1]}"></span>`;
  const keys=side==='A'?(M.soloHuman?'A·W·D eller piltaster':'A · W · D'):(M.soloHuman?'A·W·D eller piltaster':'← · ↑ · →');
  document.getElementById('miCtrl'+side).textContent=h?`🎮 ${h.label} · ${keys}`:'🤖 AI';
}

function beginPenalties(){
  const ta=TEAMS[M.a],tb=TEAMS[M.b];
  document.getElementById('psFlagA').textContent=ta.flag;
  document.getElementById('psFlagB').textContent=tb.flag;
  const nA=document.getElementById('psNameA'),nB=document.getElementById('psNameB');
  nA.textContent=ta.name;nA.style.background=ta.kit[0];nA.style.color=textColorOn(ta.kit[0]);
  nB.textContent=tb.name;nB.style.background=tb.kit[0];nB.style.color=textColorOn(tb.kit[0]);
  /* publikum i lagfarger */
  document.querySelectorAll('#crowdG .fanA').forEach(c=>c.setAttribute('fill',ta.kit[0]));
  document.querySelectorAll('#crowdG .fanB').forEach(c=>c.setAttribute('fill',tb.kit[0]));
  renderDots();updatePenScore();
  showScreen('penaltyScreen');
  setTimeout(nextKick,800);
}

function renderDots(){
  const draw=(el,results)=>{
    el.innerHTML='';
    const n=Math.max(3,results.length);
    for(let i=0;i<n;i++){
      const d=document.createElement('span');
      d.className='pdot'+(results[i]==='goal'?' goal':results[i]==='miss'?' miss':'');
      d.textContent=results[i]==='goal'?'⚽':results[i]==='miss'?'✕':'';
      el.appendChild(d);
    }
  };
  draw(document.getElementById('dotsA'),M.resultsA);
  draw(document.getElementById('dotsB'),M.resultsB);
}

function updatePenScore(){document.getElementById('psScore').textContent=`${M.scoreA} – ${M.scoreB}`;}

function decided(){
  if(!M.sudden){
    const remA=3-M.takenA,remB=3-M.takenB;
    if(M.scoreA>M.scoreB+remB)return M.a;
    if(M.scoreB>M.scoreA+remA)return M.b;
    if(M.takenA===3&&M.takenB===3&&M.scoreA!==M.scoreB)return M.scoreA>M.scoreB?M.a:M.b;
    return null;
  }
  if(M.takenA===M.takenB&&M.scoreA!==M.scoreB)return M.scoreA>M.scoreB?M.a:M.b;
  return null;
}

function setKits(){
  const shooterTeam=M.shooterIsA?M.a:M.b;
  const keeperTeam=M.shooterIsA?M.b:M.a;
  const sk=TEAMS[shooterTeam].kit,kk=TEAMS[keeperTeam].kit;
  document.getElementById('sShirt').setAttribute('fill',sk[0]);
  document.getElementById('sArmL1').setAttribute('stroke',sk[0]);
  document.getElementById('sArmR1').setAttribute('stroke',sk[0]);
  document.getElementById('sArmL2').setAttribute('stroke',sk[0]);
  document.getElementById('sArmR2').setAttribute('stroke',sk[0]);
  document.getElementById('sShorts').setAttribute('fill',sk[1]);
  document.getElementById('sLegL').setAttribute('stroke',sk[1]);
  document.getElementById('sLegR').setAttribute('stroke',sk[1]);
  document.getElementById('kShirt').setAttribute('fill',kk[0]);
  document.getElementById('kArmL').setAttribute('stroke',kk[0]);
  document.getElementById('kArmR').setAttribute('stroke',kk[0]);
  document.getElementById('kLegL').setAttribute('stroke',kk[1]==='#fff'?'#263238':kk[1]);
  document.getElementById('kLegR').setAttribute('stroke',kk[1]==='#fff'?'#263238':kk[1]);
}

function setFace(who,mood){
  document.getElementById(who==='k'?'kMouth':'sMouth').setAttribute('d',FACE[who][mood]);
}

function nextKick(){
  const w=decided();
  if(w!==null){endMatch(w);return;}
  if(!M.sudden&&M.takenA===3&&M.takenB===3){
    M.sudden=true;
    setStatus('🔥 SUDDEN DEATH – én og én straffe!');
    setTimeout(nextKick,1500);
    return;
  }
  M.shooterIsA=M.takenA===M.takenB?true:M.takenA<M.takenB;

  resetArena();
  setKits();
  setFace('k','neutral');setFace('s','neutral');

  const shooterTeam=M.shooterIsA?M.a:M.b;
  const keeperTeam=M.shooterIsA?M.b:M.a;
  M.choices={shoot:null,save:null};
  M.phase='select';
  M.curShooterCtrl=M.shooterIsA?M.ctrlA:M.ctrlB;
  M.curKeeperCtrl=M.shooterIsA?M.ctrlB:M.ctrlA;

  const ts=TEAMS[shooterTeam],tk=TEAMS[keeperTeam];
  setStatus(`⚽ ${ts.star} skyter · ${tk.star} i mål – VELG HJØRNE NÅ!`,'choosing');

  const rl=document.getElementById('readyL'),rr=document.getElementById('readyR');
  rl.className='ready-chip left';rr.className='ready-chip right';
  rl.style.setProperty('--chip',ts.kit[0]);
  rr.style.setProperty('--chip',tk.kit[0]);
  rl.textContent='⚽ '+ts.flag+' '+ts.name+(M.curShooterCtrl==='AI'?' 🤖':'');
  rr.textContent='🧤 '+tk.flag+' '+tk.name+(M.curKeeperCtrl==='AI'?' 🤖':'');

  setupTouch(M.curShooterCtrl,M.curKeeperCtrl,ts,tk);

  let t=3;
  const fill=document.getElementById('countFill');
  fill.style.width='100%';
  clearInterval(M.countTimer);
  M.countTimer=setInterval(()=>{
    t-=0.05;
    fill.style.width=Math.max(0,(t/3)*100)+'%';
    if(t<=0){clearInterval(M.countTimer);resolveKick();}
  },50);
}

function setupTouch(shooterCtrl,keeperCtrl,ts,tk){
  const L=document.getElementById('touchL'),R=document.getElementById('touchR');
  const conf=(el,labelEl,role,team,active)=>{
    el.className='touch-side '+(active?'':'inactive');
    el.style.setProperty('--tkit',active?team.kit[0]:'transparent');
    el.querySelector('.touch-label').textContent=role;
  };
  const lTeam=shooterCtrl==='L'?ts:tk, rTeam=shooterCtrl==='R'?ts:tk;
  const lRole=shooterCtrl==='L'?`⚽ ${lTeam.flag} DU SKYTER`:(keeperCtrl==='L'?`🧤 ${lTeam.flag} DU ER KEEPER`:'–');
  const rRole=shooterCtrl==='R'?`⚽ ${rTeam.flag} DU SKYTER`:(keeperCtrl==='R'?`🧤 ${rTeam.flag} DU ER KEEPER`:'–');
  conf(L,null,lRole,lTeam,shooterCtrl==='L'||keeperCtrl==='L');
  conf(R,null,rRole,rTeam,shooterCtrl==='R'||keeperCtrl==='R');
}

function touchPick(side,zone){
  if(M===null||M.phase!=='select')return;
  applyChoice(side,zone);
}

function applyChoice(side,zone){
  if(M.curShooterCtrl===side&&M.choices.shoot===null){M.choices.shoot=zone;markReady('shooter');}
  else if(M.curKeeperCtrl===side&&M.choices.save===null){M.choices.save=zone;markReady('keeper');}
  else if(M.soloHuman){
    if(M.curShooterCtrl!=='AI'&&M.choices.shoot===null){M.choices.shoot=zone;markReady('shooter');}
    else if(M.curKeeperCtrl!=='AI'&&M.choices.save===null){M.choices.save=zone;markReady('keeper');}
  }
  const shooterDone=M.curShooterCtrl==='AI'||M.choices.shoot!==null;
  const keeperDone=M.curKeeperCtrl==='AI'||M.choices.save!==null;
  if(shooterDone&&keeperDone){clearInterval(M.countTimer);setTimeout(resolveKick,250);}
}

function markReady(role){
  const el=role==='shooter'?document.getElementById('readyL'):document.getElementById('readyR');
  el.classList.add('ready');
}

function resolveKick(){
  if(M.phase!=='select')return;
  M.phase='resolve';
  const zones=['left','center','right'];
  let shoot=M.choices.shoot,save=M.choices.save;
  if(M.curShooterCtrl==='AI')shoot=zones[Math.floor(Math.random()*3)];
  if(M.curKeeperCtrl==='AI')save=zones[Math.floor(Math.random()*3)];

  const shooterTeam=M.shooterIsA?M.a:M.b;
  const ts=TEAMS[shooterTeam];

  let outcome;
  if(shoot===null)outcome='over';
  else if(save===null){outcome=(shoot==='center')?'save':'goal';save='center';}
  else outcome=(shoot===save)?'save':'goal';

  setStatus('...');
  /* 1) skytteren løper opp */
  const shooter=document.getElementById('shooterG');
  shooter.classList.add('run');

  setTimeout(()=>{
    /* 2) skudd + keeperstup */
    const keeper=document.getElementById('keeperG');
    const ball=document.getElementById('ballG');
    const net=document.getElementById('netG');
    keeper.classList.add('dive-'+(save||'center'));
    if(outcome==='save')ball.classList.add('caught-'+shoot);
    else ball.classList.add(outcome==='over'?'shoot-over':'shoot-'+shoot);

    setTimeout(()=>{
      /* 3) utfall, fjes og jubel */
      if(outcome==='goal'){
        net.classList.add('ripple');
        document.getElementById('flashL').classList.add('flash-light');
        document.getElementById('crowdG').classList.add('jump');
        setFace('s','smile');setFace('k','frown');
        shooter.classList.remove('run');
        document.getElementById('sArmsIdle').style.display='none';
        document.getElementById('sArmsUp').style.display='';
        shooter.classList.add('celebrate');
        setStatus('⚽ MÅL! '+GOAL_SHOUTS[Math.floor(Math.random()*GOAL_SHOUTS.length)],'goal-flash');
        bigBanner('MÅL! ⚽',ts.phrase,false);
        emojiBurst(['🎉','⚽','🔥','🙌']);
        spawnConfetti(18);
      } else if(outcome==='save'){
        setFace('k','smile');setFace('s','shock');
        document.getElementById('keeperBody').classList.add('celebrate');
        shooter.classList.remove('run');shooter.classList.add('sad');
        setStatus('🧤 '+SAVE_SHOUTS[Math.floor(Math.random()*SAVE_SHOUTS.length)],'save-flash');
        bigBanner('REDNING! 🧤','Keeperen vant duellen!',true);
        emojiBurst(['🧤','😱','🙅']);
      } else {
        setFace('s','frown');setFace('k','smile');
        shooter.classList.remove('run');shooter.classList.add('sad');
        setStatus('☁️ HIMMELSTRØKET! Over mål...','save-flash');
        bigBanner('OVER! ☁️','Ballen forsvant mot tribunen',true);
        emojiBurst(['☁️','😅','🫣']);
      }

      const res=outcome==='goal'?'goal':'miss';
      if(M.shooterIsA){M.takenA++;M.resultsA.push(res);if(res==='goal')M.scoreA++;}
      else{M.takenB++;M.resultsB.push(res);if(res==='goal')M.scoreB++;}
      renderDots();updatePenScore();

      setTimeout(()=>{hideBanner();nextKick();},1500);
    },550);
  },430);
}

function resetArena(){
  const keeper=document.getElementById('keeperG');
  const ball=document.getElementById('ballG');
  const net=document.getElementById('netG');
  const shooter=document.getElementById('shooterG');
  [keeper,ball,shooter].forEach(el=>{el.style.animation='none';void el.getBoundingClientRect();el.style.animation='';});
  keeper.classList.remove('dive-left','dive-right','dive-center');
  document.getElementById('keeperBody').classList.remove('celebrate');
  ball.classList.remove('shoot-left','shoot-center','shoot-right','shoot-over','caught-left','caught-center','caught-right');
  shooter.classList.remove('run','celebrate','sad');
  document.getElementById('sArmsIdle').style.display='';
  document.getElementById('sArmsUp').style.display='none';
  net.classList.remove('ripple');
  document.getElementById('flashL').classList.remove('flash-light');
  document.getElementById('crowdG').classList.remove('jump');
}

function setStatus(txt,cls){
  const el=document.getElementById('penStatus');
  el.textContent=txt;
  el.className='pen-status'+(cls?' '+cls:'');
}

function bigBanner(txt,sub,isSave){
  document.getElementById('bbText').textContent=txt;
  document.getElementById('bbText').className='bb-text'+(isSave?' save':'');
  document.getElementById('bbSub').textContent=sub||'';
  document.getElementById('bigBanner').classList.add('show');
}
function hideBanner(){document.getElementById('bigBanner').classList.remove('show');}

function emojiBurst(emojis){
  const arena=document.getElementById('arena');
  for(let i=0;i<6;i++){
    const e=document.createElement('div');
    e.className='emoji-pop';
    e.textContent=emojis[Math.floor(Math.random()*emojis.length)];
    e.style.left=(20+Math.random()*60)+'%';
    e.style.top=(30+Math.random()*40)+'%';
    e.style.animationDelay=(Math.random()*0.25)+'s';
    arena.appendChild(e);
    setTimeout(()=>e.remove(),1500);
  }
}

function endMatch(winnerTi){
  clearInterval(M.countTimer);
  const m=G.rounds[G.curRound][M.matchIdx];
  m.winner=winnerTi;m.score=[M.scoreA,M.scoreB];
  const t=TEAMS[winnerTi];
  const isFinal=G.curRound===3;
  setStatus(`🏆 ${t.name} vinner straffekonkurransen ${M.scoreA}–${M.scoreB}!`);
  bigBanner(isFinal?'VERDENSMESTER! 🏆':t.flag+' VIDERE!',t.name+' '+M.scoreA+'–'+M.scoreB,false);
  spawnConfetti(40);
  setTimeout(()=>{
    hideBanner();M=null;
    if(isFinal)crownChampion(winnerTi);
    else showBracket();
  },2400);
}

function crownChampion(ti){
  G.champion=ti;
  const t=TEAMS[ti];
  document.getElementById('champFlag').textContent=t.flag;
  document.getElementById('champTitle').textContent=t.name+' ER VERDENSMESTER!';
  document.getElementById('champSub').textContent=isHumanTeam(ti)
    ?`${humanOf(ti).label} løfter VM-pokalen! ${t.star} var iskald fra straffemerket.`
    :`${t.star} og ${t.name} tok VM-pokalen denne gangen. Revansj?`;
  spawnConfetti(60);
  showScreen('championScreen');
}

function spawnConfetti(n){
  const colors=['#f4c430','#22c55e','#e53e3e','#1e88e5','#fff'];
  for(let i=0;i<n;i++){
    setTimeout(()=>{
      const c=document.createElement('div');
      c.className='confetti-piece';
      c.style.left=Math.random()*100+'vw';
      c.style.background=colors[Math.floor(Math.random()*colors.length)];
      c.style.animationDuration=(Math.random()*1.5+1)+'s';
      document.body.appendChild(c);
      setTimeout(()=>c.remove(),2600);
    },i*25);
  }
}

document.addEventListener('keydown',(e)=>{
  if(M===null||M.phase!=='select')return;
  if(KEYMAP_R[e.key]){e.preventDefault();applyChoice('R',KEYMAP_R[e.key]);}
  const k=e.key.toLowerCase();
  if(KEYMAP_L[k])applyChoice('L',KEYMAP_L[k]);
});
</script>
</body>
