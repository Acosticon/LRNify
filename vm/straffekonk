/* ============ OPPSETT ============ */
function setPlayers(n){G={numHumans:n,humans:[],pickIdx:0};renderPick();showScreen('pickScreen');}

function renderPick(){
  document.getElementById('pickTurn').textContent=`Spiller ${G.pickIdx+1} velger lag`;
  document.getElementById('pickedRow').innerHTML=G.humans.map((h,i)=>`<div class="picked-chip">${TEAMS[h.teamIdx].flag} Spiller ${i+1}: ${TEAMS[h.teamIdx].name}</div>`).join('');
